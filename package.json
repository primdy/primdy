{
  "name": "primdy",
  "version": "0.1.7",
  "description": "Blazingly fast, file-system routed API framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primdy/primdy.git"
  },
  "bugs": {
    "url": "https://github.com/primdy/primdy/issues"
  },
  "homepage": "https://github.com/primdy/primdy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "primdy": "dist/server/spawn.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build",
    "link": "bun run build && bun link && bun link primdy",
    "test": "bun test"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "@primdy/darwin-arm64": "0.1.7",
    "@primdy/darwin-x64": "0.1.7",
    "@primdy/linux-arm64": "0.1.7",
    "@primdy/linux-x64": "0.1.7",
    "@primdy/win32-x64": "0.1.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
